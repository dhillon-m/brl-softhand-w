# Serial port lock for thread safety
serial_lock = threading.Lock()


################
# Data storage #
################

# Logging buffers
timestamps, joint_data, pose_data = [], [], []

# Sampler thread control
_log_stop = threading.Event()
_log_thread = None
start_time = None

def _sampler(robot, dt = 0.01):
    """Poll robot state at fixed rate and append to buffers."""
    while not _log_stop.is_set():
        t = time.time() - start_time
        try:
            j = tuple(robot.joint_angles)
            p = tuple(robot.pose)
            timestamps.append(t)
            joint_data.append(j)
            pose_data.append(p)
        except Exception:
            pass
        time.sleep(dt)

def start_logger(robot, dt = 0.01):
    """Begin background logging of robot state."""
    global _log_thread, start_time
    start_time = time.time()
    _log_stop.clear()
    _log_thread = threading.Thread(target=_sampler, args=(robot, dt), daemon=True)
    _log_thread.start()
    
def stop_logger():
    """Stop background logging of robot state."""
    _log_stop.set()
    if _log_thread is not None:
        _log_thread.join()

def save_to_csv(filename):
    """Save logged data to a CSV file."""
    header = ["time_s"] + [f"joint_{i+1}_deg" for i in range(6)] + \
             ["x_mm", "y_mm", "z_mm", "rx_deg", "ry_deg", "rz_deg"]
    with open(filename, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(header)
        for t, j, p in zip(timestamps, joint_data, pose_data):
            w.writerow([t] + list(j) + list(p))


##############################
# Real-time TCP update thread #
##############################

_tcp_stop = threading.Event()
_tcp_thread = None

def _tcp_updater(robot, ser, dt=0.01):
    """Update robot TCP in real time based on wrist angles."""
    while not _tcp_stop.is_set():
        with serial_lock:
            flexion_angle, ulnar_angle = swl.get_wrist_angles(ser)
        if flexion_angle is not None and ulnar_angle is not None:
            tcp_pose = swl.compute_tcp_from_wrist(flexion_angle, ulnar_angle)
            robot.tcp = tuple(tcp_pose)
        time.sleep(dt)

def start_tcp_updater(robot, ser, dt=0.01):
    global _tcp_thread
    _tcp_stop.clear()
    _tcp_thread = threading.Thread(target=_tcp_updater, args=(robot, ser, dt), daemon=True)
    _tcp_thread.start()

def stop_tcp_updater():
    _tcp_stop.set()
    if _tcp_thread is not None:
        _tcp_thread.join()


################################
# Setup wrist and hand control #
################################

# List available serial ports
ports = serial.tools.list_ports.comports()
for port in ports:
    print(port.device)

# Open serial port
ser = serial.Serial('COM5', baudrate=1000000, timeout=0.1)


###############
# Test Script #
###############

# Set up base and work coordinate frames
base_frame = (0, 0, 0, 0, 0, 0)
work_frame = (10, -580, 350, 90, 0, 0)   # base frame: x->right, y->back, z->up

# Configure UR5 robot
with AsyncRobot(SyncRobot(RTDEController(ip='192.168.1.164'))) as robot:
    robot.axes = 'sxyz'
    robot.tcp = (0, 0, 285, 0, 0, 0)
    robot.linear_speed = 100
    robot.angular_speed = 100
    robot.coord_frame = work_frame
    
    # Home position
    with serial_lock:
        swl.home_hand(ser)
    robot.move_linear((0, 0, 0, 0, 0, 0))
    
    # Start logging robot state
    start_logger(robot, dt=0.01)

    # Start TCP updater
    start_tcp_updater(robot, ser, dt=0.01)

    ##############
    # Operations #
    ##############

    # Move to twister
    for _ in range(3):
        robot.move_linear((1, -255, -5, 0, 0, 0))
        time.sleep(2)
        swl.close_hand(ser)
        swl.wait_for_servo(ser, servo_ids=[2,3])
        time.sleep(2)

        # Rotate
        robot.move_linear((1, -255, -5, 0, 30, 0))
        time.sleep(2)

        # Release and lift
        swl.open_hand(ser)
        swl.wait_for_servo(ser, servo_ids=[2,3])
        time.sleep(2)
        robot.move_linear((1, -235, -5, 0, 30, 0))  # Lift
        time.sleep(2)

        # Unrotate wrist
        robot.move_linear((1, -235, -5, 0, 0, 0))
        time.sleep(2)
    
    # Home position
    with serial_lock:
        swl.home_hand(ser)
    robot.move_linear((0, 0, 0, 0, 0, 0))

    # Stop TCP updater
    stop_tcp_updater()

    # Stop logging
    stop_logger()
    
    
# Close the serial port
ser.close()


